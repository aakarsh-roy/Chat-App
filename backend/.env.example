# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For production, use MongoDB Atlas or a properly secured MongoDB instance
MONGO_URI=mongodb://localhost:27017/chatapp

# JWT Configuration
# IMPORTANT: Use a strong, random secret key (minimum 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secure-secret-key-minimum-32-characters-long-change-this
JWT_EXPIRE=7d

# Cloudinary Configuration (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URL
CLIENT_URL=http://localhost:3000
